# Copia este archivo como .env y rellena los valores.
# En producción (Render) estas variables se configuran en el panel del servicio, no con un archivo.

PORT=4000

# Usa una base distinta para desarrollo y producción (cambia el nombre después de la "/")
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/pandax_dev?retryWrites=true&w=majority

JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Uno o varios orígenes permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# ---------- Correo (formulario de contacto y recuperar contraseña) ----------
# PRODUCCIÓN (Render): usa Brevo. El plan gratis de Render bloquea los puertos SMTP, pero la API
# HTTP de Brevo funciona. Crea la clave en Brevo → SMTP & API → API Keys (clave v3, no la SMTP)
# y verifica tu correo como remitente en Senders.
BREVO_API_KEY=
# Remitente verificado en Brevo (o tu Gmail si usas SMTP)
EMAIL_FROM=tucorreo@gmail.com
# Dónde quieres recibir los mensajes del formulario de contacto (por defecto, EMAIL_FROM)
CONTACTO_EMAIL=

# LOCAL (opcional): SMTP, p. ej. Gmail con una "contraseña de aplicación". Sólo se usa si
# BREVO_API_KEY está vacío.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=

# Registro de cuentas nuevas. Déjalo en false: el panel es de un único administrador.
REGISTRO_ABIERTO=false
